# Backend Node.js .gitignore for RestaurantOS

# ============================
# Dependencies
# ============================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
package-lock.json
yarn.lock
pnpm-lock.yaml

# ============================
# Environment Variables
# ============================
.env
.env.local
.env.development
.env.production
.env.test
.env.*.local
.env.backup

# ============================
# Server Files
# ============================
dist/
build/
out/
*.pid
*.pid.lock

# ============================
# Logs
# ============================
logs/
*.log
access.log
error.log
combined.log
prod.log

# ============================
# Database Files
# ============================
*.sqlite
*.sqlite3
*.db
*.db-journal
*.dump
*.dmp
migrations/*.sql
seeders/*.sql

# ============================
# Uploads/Downloads
# ============================
uploads/
downloads/
temp/
tmp/
storage/
files/
assets/
public/uploads/
public/downloads/

# ============================
# Testing
# ============================
coverage/
.nyc_output/
*.test.js
*.spec.js
__tests__/
reports/
jest-coverage/
mochawesome-report/

# ============================
# OS Files
# ============================
.DS_Store
Thumbs.db
*.swp
*.swo
*~
*.bak
*.backup

# ============================
# IDE Files
# ============================
.vscode/
.idea/
*.iml
.project
.classpath
.settings/
*.sublime-workspace
*.sublime-project

# ============================
# Compression
# ============================
*.zip
*.tar.gz
*.rar
*.7z

# ============================
# Certificates
# ============================
*.pem
*.key
*.crt
*.csr
*.p12
*.pfx
cert/
certs/
ssl/
ssl-cert/

# ============================
# Configuration Files
# ============================
config.local.js
config.json
config.yaml
config.yml
*.config.js
*.config.json

# ============================
# Secrets
# ============================
.secrets/
secrets.json
secrets.yaml
credentials.json
service-account.json
*.secret
*.secure

# ============================
# Temporary Files
# ============================
tmp/
temp/
*.tmp
.cache/
*.pid

# ============================
# Documentation
# ============================
docs/_build/
docs/html/
docs/latex/
docs/api/

# ============================
# Performance Reports
# ============================
.clinic/
profile-*
*.cpuprofile
*.heapsnapshot

# ============================
# PM2
# ============================
.pm2/
pm2-*.log
pm2.pid

# ============================
# Docker
# ============================
docker-compose.override.yml
.dockerignore

# ============================
# TypeScript
# ============================
*.tsbuildinfo
*.js.map
*.d.ts.map
*.d.ts

# ============================
# Redis
# ============================
dump.rdb
appendonly.aof

# ============================
# Elasticsearch
# ============================
elasticsearch/
*.log.*